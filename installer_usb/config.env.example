# ========================================================
# NEXUS 3D — Bridge Configuration Template
# Place in the same folder as bridge_daemon.py as 'config.env'
# ========================================================

# Pantheon Cloud Ingestion Endpoint
PANTHEON_URL=https://dev-nexus3-d.pantheonsite.io/index.php?route=api&action=push

# Shared Bearer API Token (matches private/config.php)
API_TOKEN=nxs_a7f3b9e2d1c4056789abcdef01234567

# Primary Printer (QIDI Q2)
PRINTER_1_NAME=QIDI Q2
PRINTER_1_IP=192.168.1.124
PRINTER_1_PORT=7125
PRINTER_1_CAM_STREAM=http://192.168.1.124/webcam/?action=stream
PRINTER_1_CAM_SNAPSHOT=http://192.168.1.124/webcam/?action=snapshot
PRINTER_1_ENABLED=true

# Secondary Printer (Fleet Slot 2 - Optional)
PRINTER_2_NAME=Printer 02 (CoreXY)
PRINTER_2_IP=192.168.1.36
PRINTER_2_PORT=7125
PRINTER_2_CAM_STREAM=http://192.168.1.36:8080/?action=stream
PRINTER_2_CAM_SNAPSHOT=http://192.168.1.36:8080/?action=snapshot
PRINTER_2_ENABLED=false

# Polling and Relay Frequencies (seconds)
POLL_INTERVAL_SECONDS=2.0
SNAPSHOT_INTERVAL_SECONDS=2.0

# Logging
LOG_FILE=bridge.log
